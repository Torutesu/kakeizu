# ============================================================================
# 確認用の環境を構築・更新し、実機確認を流すための環境変数（docs/HANDOFF.md）
#
#   cp .env.qa.example .env.qa.local     # .env* は gitignore 済み。コミットされない
#   （値を埋める）
#   set -a; . ./.env.qa.local; set +a     # 今のシェルに読み込む
#   pnpm provision / pnpm qa:accounts / pnpm qa:live
#
# 鍵は管理画面からこのファイルへ直接貼る。チャット・コミット・ログ・画面の写しに出さない。
# 作業が終わったらこのファイルを消し、トークンの失効を依頼者に頼む。
# ============================================================================

# ---- 構築・デプロイ（pnpm provision）----
# Supabase: Account → Access Tokens（docs/KEYS_SETUP.md 1）
SUPABASE_ACCESS_TOKEN=
# Vercel: Account Settings → Tokens。有効期限は最短に（docs/KEYS_SETUP.md 2）
VERCEL_TOKEN=
# 既存の確認用環境の名前（Supabase のプロジェクト名・Vercel のプロジェクト名）
PROJECT_NAME=kakeizu
# 無料枠のまま確認用の環境として使う場合だけ true（本物の戸籍は入れない）
ALLOW_FREE_PLAN=true

# ---- 読み取りAI ----
GEMINI_API_KEY=
# ⚠ provision は毎回この値で上書きする。空にすると false になり、見本限定が外れる。
#    課金を有効にしたキーで AI_NO_TRAINING_CONFIRMED=true にするまでは true のまま
AI_SAMPLE_ONLY=true
# 課金を有効にした Gemini のキーで、学習に使われない条件を確かめた場合だけ true（docs/AI_DATA_POLICY.md）
AI_NO_TRAINING_CONFIRMED=false

# ---- テスト用の利用者（pnpm qa:accounts）・実機確認（pnpm qa:live）----
# Supabase: Project Settings → API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
# RLS を迂回する鍵。確認用の環境でだけ使う（AGENTS.md 2）
SUPABASE_SERVICE_ROLE_KEY=

# メールアドレスとパスワードは依頼者が決める
LIVE_ADMIN_EMAIL=
LIVE_ADMIN_PASSWORD=
LIVE_WORKER_EMAIL=
LIVE_WORKER_PASSWORD=
LIVE_VIEWER_EMAIL=
LIVE_VIEWER_PASSWORD=

# 公開URL（provision の出力、または /api/health が通るURL）
LIVE_BASE_URL=https://kakeizu-five.vercel.app
# 閲覧者を担当に割り当てた案件のid（7-3 で使う）。無ければ空のまま（7-3 は skip になる）
LIVE_PROJECT_ID=
# 見本限定の環境では true（設定確認の期待値が変わる）
LIVE_SAMPLE_ONLY=true
