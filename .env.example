# Supabase（認証・DB・アクセス制御）
# 取得先: Supabaseダッシュボード → Settings → API（手順は docs/SUPABASE_SETUP.md 参照）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 招待メールの送信に使用（Settings → API → service_role）。
# ⚠ このキーはRLSを完全に迂回します。サーバー側でのみ使用し、
#   NEXT_PUBLIC_ を付けないこと（付けるとブラウザに露出します）。
# 未設定でも招待自体は作成されますが、メールは送信されません。
SUPABASE_SERVICE_ROLE_KEY=

# ---- 戸籍解析AI（サーバー側でのみ使用。ブラウザには一切送信されません） ----
# 1つ以上のAPIキーを設定してください。設定されたプロバイダが自動フォールバック
# チェーンに組み込まれます。モデル比較の根拠は docs/MODEL_RESEARCH.md を参照。

# Google Gemini（既定プロバイダ。gemini-4-argon を使用し、使えなければ 3.1 Pro → 2.5 Pro）
# 取得先: https://aistudio.google.com/app/apikey
# **必ず課金を有効にしたプロジェクトのキーを使う**（無料枠は入力が学習に使われる）。
# Google AI Pro / Ultra のサブスクに付く月々のクレジットを充てる場合は、
# Google Developer Program でクレジットを有効にし、このキーのプロジェクトの請求先に紐づける。
GEMINI_API_KEY=

# 任意: 書類を読み取る解像度（low | medium | high | ultra_high。既定 high）。
# 手書きの細かい字画を読むため既定を high にしている。ultra_high は画像のみ有効
# GEMINI_MEDIA_RESOLUTION=high

# Anthropic Claude（複雑な構造化抽出で最高精度。claude-opus-5 を使用）
# 取得先: https://platform.claude.com/
# ANTHROPIC_API_KEY=

# OpenAI GPT（手書きCERベンチマークでSOTA級。gpt-5.2 を使用）
# 取得先: https://platform.openai.com/
# OPENAI_API_KEY=

# 任意: 第一候補のプロバイダとモデルを明示指定する
# ANALYSIS_PROVIDER=gemini   # gemini | anthropic | openai
# ANALYSIS_MODEL=gemini-4-argon

# ---- 2モデル照合（既定で有効） ----
# 別のモデルでも解析し、結果を突き合わせて食い違いを洗い出します。
# 食い違った箇所は画面の「要確認」に一覧表示されます。
#
# 別プロバイダのキーがあればそちらで、Geminiだけなら Gemini 3.8 Flash で照合します
# （同じモデルを2回呼んでも同じ誤読を再現するだけなので、必ず別のモデルを使う）。
# 解析は2つ同時に走るため、待ち時間は増えません。Flashでの照合は主の解析の3〜4割程度の費用です。
# 詳細と試算は docs/MODEL_RESEARCH.md を参照。

# 照合を止める場合のみ設定する
# ANALYSIS_ENSEMBLE=false

# 任意: 照合に使うプロバイダとモデルを明示指定する（未指定なら自動選択）
# ANALYSIS_ENSEMBLE_PROVIDER=gemini
# ANALYSIS_ENSEMBLE_MODEL=gemini-3.8-flash

# ---- 月の解析予算 ----
# 当月（日本時間）の見積もり原価の合計がこの金額（USD）に達したら、新しい解析を止めます。
# サブスク枠のクレジット（例: Google AI Pro は月$10）に収めたい場合に設定します。
# 原価は実測トークン × 公式単価（lib/analysis/pricing.ts）の見積もりで、照合の分も含みます。
# 未設定なら無制限。マイグレーション 0012（analysis_usage）の適用が必要です。
# ANALYSIS_MONTHLY_BUDGET_USD=10

# ---- AIデータ利用ポリシーの確認（本番では必須・コメントを外すこと） ----
# 各社が入力を学習に使わない条件（docs/AI_DATA_POLICY.md）を満たしたことの表明。
#
# ⚠ 本番環境でこれが true でないと、解析は実行されず必ずエラーになります。
#   デプロイ後に「解析が動かない」となる原因の大半がこれです。
#   戸籍という機微情報を、条件を確認しないまま外部へ送らせないための仕組みです。
#
# 各社の有料プラン（学習不使用）の契約を確認したうえで、コメントを外してください。
AI_NO_TRAINING_CONFIRMED=true
