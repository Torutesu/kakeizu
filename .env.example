# Supabase（認証・DB・アクセス制御）
# 取得先: Supabaseダッシュボード → Settings → API（手順は docs/SUPABASE_SETUP.md 参照）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API キー（サーバー側でのみ使用されます。ブラウザには一切送信されません）
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 戸籍解析に使うGeminiモデル（省略時: gemini-3-pro-preview。
# 利用できない場合は gemini-2.5-pro に自動フォールバックします）
# GEMINI_MODEL=
