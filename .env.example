# Supabase（認証・DB・アクセス制御）
# 取得先: Supabaseダッシュボード → Settings → API（手順は docs/SUPABASE_SETUP.md 参照）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- 戸籍解析AI（サーバー側でのみ使用。ブラウザには一切送信されません） ----
# 1つ以上のAPIキーを設定してください。設定されたプロバイダが自動フォールバック
# チェーンに組み込まれます。モデル比較の根拠は docs/MODEL_RESEARCH.md を参照。

# Google Gemini（既定プロバイダ。gemini-3.1-pro を使用）
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude（複雑な構造化抽出で最高精度。claude-opus-5 を使用）
# 取得先: https://platform.claude.com/
# ANTHROPIC_API_KEY=

# OpenAI GPT（手書きCERベンチマークでSOTA級。gpt-5.2 を使用）
# 取得先: https://platform.openai.com/
# OPENAI_API_KEY=

# 任意: 第一候補のプロバイダとモデルを明示指定する
# ANALYSIS_PROVIDER=gemini   # gemini | anthropic | openai
# ANALYSIS_MODEL=gemini-3.1-pro
